{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "sources": "https://github.com/TheArtyrian/vectorlib-mc/"
    },
    "license": "${license}",
    "icon": "${mod_logo}.png",
    "environment": "*",
    "accessWidener": "vectorlib.accesswidener",
    "entrypoints": {
        "main": [
            "net.vertisoft.vectorlib.VectorLibFabric"
        ],
        "client" : [
            "net.vertisoft.vectorlib.VectorLibFabricClient"
        ],
        "fabric-datagen": [
            "net.vertisoft.vectorlib.VectorLibFabricDatagen"
        ],
        "preLaunch": [
            "com.llamalad7.mixinextras.MixinExtrasBootstrap::init"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  